<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Name="WPFMainGrid" ShowGridLines="False" HorizontalAlignment="Stretch">
    <!-- Slot="..." attributes are placeholders replaced by ConvertTo-WinUtilRedesignInterface with the
         upstream controls (so every named control and its handlers keep working). -->
    <Grid.Background>
        <RadialGradientBrush Center="0.75,-0.08" GradientOrigin="0.75,-0.08" RadiusX="0.7" RadiusY="0.55">
            <GradientStop Color="#15294D" Offset="0"/>
            <GradientStop Color="#0A0F1C" Offset="1"/>
        </RadialGradientBrush>
    </Grid.Background>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="56"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ContentControl Slot="Offline" Grid.Row="0"/>

    <!-- Title bar -->
    <Border Grid.Row="1" BorderBrush="#16213A" BorderThickness="0,0,0,1" IsHitTestVisible="False"/>
    <Grid Name="GridBesideNavDockPanel" Grid.Row="1" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Name="NavDockPanel" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0" Background="Transparent">
            <Grid Width="28" Height="28" AutomationProperties.Name="WinUtil">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Margin="1" CornerRadius="2" Background="#4CC2FF"/>
                <Border Grid.Row="0" Grid.Column="1" Margin="1" CornerRadius="2" Background="#2F8BFF"/>
                <Border Grid.Row="1" Grid.Column="0" Margin="1" CornerRadius="2" Background="#2F8BFF"/>
                <Border Grid.Row="1" Grid.Column="1" Margin="1" CornerRadius="2" Background="#4CC2FF"/>
            </Grid>
            <TextBlock Text="WinUtil" Margin="12,0,0,0" FontSize="{DynamicResource RdFontBrand}" FontWeight="Bold" Foreground="#EAF0FA" VerticalAlignment="Center"/>
            <StackPanel Name="NavLogoPanel" Orientation="Horizontal" Visibility="Collapsed"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
            <Button Name="WPFRedesignHelpButton" Style="{StaticResource RdCaptionButtonStyle}" Content="&#xE897;"
                    ToolTip="Help" AutomationProperties.Name="Help"/>
            <ContentControl Slot="WindowButtons"/>
        </StackPanel>
    </Grid>

    <!-- Body: sidebar | center | right panel -->
    <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="296"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#B3090E1A" BorderBrush="#16213A" BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Name="WPFRedesignNav" Orientation="Vertical">
                        <ToggleButton Name="WPFTab7BT" Style="{StaticResource RdNavToggleStyle}" MinHeight="44" Padding="14,2" Margin="0,0,0,2" AutomationProperties.Name="Home">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Name="WPFRedesignNavIcon7" Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource RdIconM}" Width="30" Foreground="#CFE0F5" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock TextWrapping="Wrap" Name="WPFRedesignNavTitle7" Text="Home" FontSize="{DynamicResource RdFontMedium}" FontWeight="Bold" Foreground="#EAF0FA"/>
                                    <TextBlock Name="WPFRedesignNavSub7" Text="" Visibility="Collapsed" FontSize="{DynamicResource RdFontSmall}" Foreground="#9FB0C9" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </ToggleButton>
                        <TextBlock Name="WPFRedesignGroup1" Text="" FontSize="{DynamicResource RdFontSmall}" FontWeight="Bold" Foreground="#9FB0C9" Margin="14,12,0,4"/>
                        <ToggleButton Name="WPFTab1BT" Style="{StaticResource RdNavToggleStyle}" MinHeight="44" Padding="14,2" Margin="0,0,0,2" AutomationProperties.Name="Programs">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Name="WPFRedesignNavIcon1" Text="&#xE7B8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource RdIconM}" Width="30" Foreground="#CFE0F5" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock TextWrapping="Wrap" Name="WPFRedesignNavTitle1" Text="Programs" FontSize="{DynamicResource RdFontMedium}" FontWeight="Bold" Foreground="#EAF0FA"/>
                                    <TextBlock Name="WPFRedesignNavSub1" Text="" Visibility="Collapsed" FontSize="{DynamicResource RdFontSmall}" Foreground="#9FB0C9" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </ToggleButton>
                        <TextBlock Name="WPFRedesignGroup2" Text="" FontSize="{DynamicResource RdFontSmall}" FontWeight="Bold" Foreground="#9FB0C9" Margin="14,12,0,4"/>
                        <ToggleButton Name="WPFTab2BT" Style="{StaticResource RdNavToggleStyle}" MinHeight="44" Padding="14,2" Margin="0,0,0,2" AutomationProperties.Name="Tweaks">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Name="WPFRedesignNavIcon2" Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource RdIconM}" Width="30" Foreground="#CFE0F5" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock TextWrapping="Wrap" Name="WPFRedesignNavTitle2" Text="Tweaks" FontSize="{DynamicResource RdFontMedium}" FontWeight="Bold" Foreground="#EAF0FA"/>
                                    <TextBlock Name="WPFRedesignNavSub2" Text="" Visibility="Collapsed" FontSize="{DynamicResource RdFontSmall}" Foreground="#9FB0C9" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </ToggleButton>
                        <ToggleButton Name="WPFTab6BT" Style="{StaticResource RdNavToggleStyle}" MinHeight="44" Padding="14,2" Margin="0,0,0,2" AutomationProperties.Name="Windows app cleanup">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Name="WPFRedesignNavIcon6" Text="&#xE8A9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource RdIconM}" Width="30" Foreground="#CFE0F5" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock TextWrapping="Wrap" Name="WPFRedesignNavTitle6" Text="Windows app cleanup" FontSize="{DynamicResource RdFontMedium}" FontWeight="Bold" Foreground="#EAF0FA"/>
                                    <TextBlock Name="WPFRedesignNavSub6" Text="" Visibility="Collapsed" FontSize="{DynamicResource RdFontSmall}" Foreground="#9FB0C9" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </ToggleButton>
                        <TextBlock Name="WPFRedesignGroup3" Text="" FontSize="{DynamicResource RdFontSmall}" FontWeight="Bold" Foreground="#9FB0C9" Margin="14,12,0,4"/>
                        <ToggleButton Name="WPFTab4BT" Style="{StaticResource RdNavToggleStyle}" MinHeight="44" Padding="14,2" Margin="0,0,0,2" AutomationProperties.Name="Updates">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Name="WPFRedesignNavIcon4" Text="&#xE895;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource RdIconM}" Width="30" Foreground="#CFE0F5" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock TextWrapping="Wrap" Name="WPFRedesignNavTitle4" Text="Updates" FontSize="{DynamicResource RdFontMedium}" FontWeight="Bold" Foreground="#EAF0FA"/>
                                    <TextBlock Name="WPFRedesignNavSub4" Text="" Visibility="Collapsed" FontSize="{DynamicResource RdFontSmall}" Foreground="#9FB0C9" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </ToggleButton>
                        <ToggleButton Name="WPFTab3BT" Style="{StaticResource RdNavToggleStyle}" MinHeight="44" Padding="14,2" Margin="0,0,0,2" AutomationProperties.Name="Repair">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Name="WPFRedesignNavIcon3" Text="&#xE90F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource RdIconM}" Width="30" Foreground="#CFE0F5" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock TextWrapping="Wrap" Name="WPFRedesignNavTitle3" Text="Repair" FontSize="{DynamicResource RdFontMedium}" FontWeight="Bold" Foreground="#EAF0FA"/>
                                    <TextBlock Name="WPFRedesignNavSub3" Text="" Visibility="Collapsed" FontSize="{DynamicResource RdFontSmall}" Foreground="#9FB0C9" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </ToggleButton>
                        <TextBlock Name="WPFRedesignGroup4" Text="" FontSize="{DynamicResource RdFontSmall}" FontWeight="Bold" Foreground="#9FB0C9" Margin="14,12,0,4"/>
                        <ToggleButton Name="WPFTab5BT" Style="{StaticResource RdNavToggleStyle}" MinHeight="44" Padding="14,2" Margin="0,0,0,2" AutomationProperties.Name="Create ISO">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Name="WPFRedesignNavIcon5" Text="&#xE958;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource RdIconM}" Width="30" Foreground="#CFE0F5" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock TextWrapping="Wrap" Name="WPFRedesignNavTitle5" Text="Create ISO" FontSize="{DynamicResource RdFontMedium}" FontWeight="Bold" Foreground="#EAF0FA"/>
                                    <TextBlock Name="WPFRedesignNavSub5" Text="" Visibility="Collapsed" FontSize="{DynamicResource RdFontSmall}" Foreground="#9FB0C9" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </ToggleButton>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,12,0,0">
                    <Border Background="#0F182B" BorderBrush="#1B2842" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource RdIconM}" Foreground="#4CC2FF" VerticalAlignment="Top" Margin="0,2,12,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Name="WPFRedesignStatusTitle" Text="" FontSize="{DynamicResource RdFontBody}" FontWeight="Bold" Foreground="#EAF0FA" TextWrapping="Wrap"/>
                                <TextBlock Name="WPFRedesignStatusNote" Text="" FontSize="{DynamicResource RdFontSmall}" Foreground="#9FB0C9" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button Name="WPFRedesignSettingsButton" Style="{StaticResource RdGhostButtonStyle}" AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource RdIconS}" Width="30" Foreground="#CFE0F5" VerticalAlignment="Center"/>
                            <TextBlock Name="WPFRedesignSettingsText" Text="Settings" FontSize="{DynamicResource RdFontBody}" Foreground="#CFE0F5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Name="WPFRedesignAboutButton" Style="{StaticResource RdGhostButtonStyle}" AutomationProperties.Name="About">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE897;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource RdIconS}" Width="30" Foreground="#CFE0F5" VerticalAlignment="Center"/>
                            <TextBlock Name="WPFRedesignAboutText" Text="About" FontSize="{DynamicResource RdFontBody}" Foreground="#CFE0F5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Name="WPFRedesignLangButton" Style="{StaticResource RdSecondaryButtonStyle}" Margin="0,6,0,0" FontWeight="SemiBold" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Switch language">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource RdIconS}" Width="30" Foreground="#EAF0FA" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Name="WPFRedesignLangName" Text="Italiano" FontSize="{DynamicResource RdFontBody}" Foreground="#EAF0FA" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Name="WPFRedesignLangCode" Text="EN" FontSize="{DynamicResource RdFontSmall}" FontWeight="Bold" Foreground="#9FB0C9" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Center -->
        <Grid Grid.Column="1" Margin="32,24,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock Name="WPFRedesignPageTitle" Text="Tweaks" FontSize="{DynamicResource RdFontPage}" FontWeight="ExtraBold" Foreground="#EAF0FA" TextTrimming="CharacterEllipsis"/>
                <TextBlock Name="WPFRedesignPageSubtitle" Text="" FontSize="{DynamicResource RdFontLead}" Foreground="#9FB0C9" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Grid Slot="SearchBox" Grid.Row="1" Margin="0,18,0,0"/>
            <ContentControl Slot="TabHost" Grid.Row="2" Margin="0,8,0,0"/>
        </Grid>

        <!-- Right panel: what the focused tweak does, impact, apply -->
        <Border Name="WPFRedesignRightPanel" Grid.Column="2" Width="420" Margin="4,16,20,20" CornerRadius="20" BorderBrush="#1E2A44" BorderThickness="1" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#EB121C33" Offset="0"/>
                    <GradientStop Color="#EB0C1324" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, ElementName=WPFTab2}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,26,24,8">
                    <StackPanel>
                        <TextBlock Name="WPFRedesignBeforeTitle" Text="Before you apply" FontSize="{DynamicResource RdFontHeading}" FontWeight="ExtraBold" Foreground="#EAF0FA" TextWrapping="Wrap"/>
                        <TextBlock Name="WPFRedesignSelCount" Text="" FontSize="{DynamicResource RdFontMedium}" Foreground="#9FB0C9" Margin="0,4,0,0"/>

                        <Border Name="WPFRedesignFocusCard" Margin="0,18,0,0" Padding="14" CornerRadius="14" Background="#0F1A30" BorderBrush="#2A4A73" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="52" Height="52" CornerRadius="13" BorderBrush="#243558" BorderThickness="1" Background="#16223C">
                                    <TextBlock Name="WPFRedesignFocusIcon" Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource RdIconXL}" Foreground="#7FD3FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Name="WPFRedesignFocusName" Text="" FontSize="{DynamicResource RdFontLead}" FontWeight="Bold" Foreground="#EAF0FA" TextWrapping="Wrap" MaxWidth="260"/>
                                    <TextBlock Name="WPFRedesignFocusDesc" Text="" FontSize="{DynamicResource RdFontBody}" Foreground="#9FB0C9" TextWrapping="Wrap" MaxWidth="260" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Name="WPFRedesignNoFocus" Text="" FontSize="{DynamicResource RdFontBody}" Foreground="#9FB0C9" TextWrapping="Wrap" Margin="0,18,0,0"/>

                        <StackPanel Name="WPFRedesignDetails" Margin="0,18,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource RdIconM}" Width="38" Foreground="#CFE0F5" VerticalAlignment="Top"/>
                                <StackPanel>
                                    <TextBlock Name="WPFRedesignWhatTitle" Text="What changes" FontSize="{DynamicResource RdFontBody}" FontWeight="Bold" Foreground="#EAF0FA"/>
                                    <TextBlock Name="WPFRedesignWhatText" Text="" FontSize="{DynamicResource RdFontBody}" Foreground="#9FB0C9" TextWrapping="Wrap" MaxWidth="290" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource RdIconM}" Width="38" Foreground="#CFE0F5" VerticalAlignment="Top"/>
                                <StackPanel>
                                    <TextBlock Name="WPFRedesignEffTitle" Text="Possible effects" FontSize="{DynamicResource RdFontBody}" FontWeight="Bold" Foreground="#EAF0FA"/>
                                    <TextBlock Name="WPFRedesignEffText" Text="" FontSize="{DynamicResource RdFontBody}" Foreground="#9FB0C9" TextWrapping="Wrap" MaxWidth="290" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <TextBlock Text="&#xE7A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource RdIconM}" Width="38" Foreground="#CFE0F5" VerticalAlignment="Top"/>
                                <StackPanel>
                                    <TextBlock Name="WPFRedesignUndoTitle" Text="Undo" FontSize="{DynamicResource RdFontBody}" FontWeight="Bold" Foreground="#EAF0FA"/>
                                    <TextBlock Name="WPFRedesignUndoText" Text="" FontSize="{DynamicResource RdFontBody}" Foreground="#9FB0C9" TextWrapping="Wrap" MaxWidth="290" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Name="WPFRedesignWarnBox" Margin="0,18,0,0" Padding="14,12" CornerRadius="14" Background="#2A2210" BorderBrush="#6B531C" BorderThickness="1" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource RdIconM}" Width="34" Foreground="#F5B94A" VerticalAlignment="Top"/>
                                    <TextBlock Name="WPFRedesignWarnText" Text="" FontSize="{DynamicResource RdFontBody}" Foreground="#FFE3A8" TextWrapping="Wrap" MaxWidth="290"/>
                                </StackPanel>
                            </Border>
                            <Border Name="WPFRedesignSafeBox" Margin="0,18,0,0" Padding="14,12" CornerRadius="14" Background="#0F2E2A" BorderBrush="#1D5A4A" BorderThickness="1" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA18;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource RdIconM}" Width="34" Foreground="#6FD6A0" VerticalAlignment="Top"/>
                                    <TextBlock Name="WPFRedesignSafeText" Text="" FontSize="{DynamicResource RdFontBody}" Foreground="#C6F3DC" TextWrapping="Wrap" MaxWidth="290"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Margin="0,18,0,12" Padding="16" CornerRadius="14" Background="#0D1628" BorderBrush="#1B2842" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Name="WPFRedesignImpactTitle" Text="Estimated impact" FontSize="{DynamicResource RdFontSmall}" FontWeight="Bold" Foreground="#9FB0C9"/>
                                <TextBlock Name="WPFRedesignImpactNote" Text="" FontSize="{DynamicResource RdFontSmall}" Foreground="#9FB0C9" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Name="WPFRedesignImpactEmpty" Text="" FontSize="{DynamicResource RdFontBody}" Foreground="#CFE0F5" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                <StackPanel Name="WPFRedesignBars">
                                    <Grid Name="WPFRedesignBar1Row" Margin="0,12,0,0">
                                        <TextBlock Name="WPFRedesignBar1Label" Text="" FontSize="{DynamicResource RdFontBody}" Foreground="#CFE0F5"/>
                                        <TextBlock Name="WPFRedesignBar1Value" Text="" FontSize="{DynamicResource RdFontBody}" FontWeight="Bold" Foreground="#EAF0FA" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar Name="WPFRedesignBar1" Margin="0,6,0,0" Height="7" Minimum="0" Maximum="100" Value="0" Style="{StaticResource RdBarStyle}" AutomationProperties.Name="Services changed"/>
                                    <Grid Name="WPFRedesignBar2Row" Margin="0,12,0,0">
                                        <TextBlock Name="WPFRedesignBar2Label" Text="" FontSize="{DynamicResource RdFontBody}" Foreground="#CFE0F5"/>
                                        <TextBlock Name="WPFRedesignBar2Value" Text="" FontSize="{DynamicResource RdFontBody}" FontWeight="Bold" Foreground="#EAF0FA" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar Name="WPFRedesignBar2" Margin="0,6,0,0" Height="7" Minimum="0" Maximum="100" Value="0" Style="{StaticResource RdBarStyle}" AutomationProperties.Name="Registry values changed"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer: actions, or the mirrored job progress while one runs -->
                <Border Grid.Row="1" Padding="24,16,24,20" BorderBrush="#1E2A44" BorderThickness="0,1,0,0" Background="#8C090E1A">
                    <Grid>
                        <StackPanel Name="WPFRedesignActions">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Visibility, ElementName=WPFTweaksProgressBar}" Value="Visible">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1.3*"/>
                                </Grid.ColumnDefinitions>
                                <ContentControl Slot="ClearButton" Grid.Column="0"/>
                                <ContentControl Slot="ApplyButton" Grid.Column="2"/>
                            </Grid>
                            <ContentControl Slot="UndoButton"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource RdIconS}" Width="26" Foreground="#9FB0C9" VerticalAlignment="Top"/>
                                <TextBlock Name="WPFRedesignFootNote" Text="" FontSize="{DynamicResource RdFontSmall}" Foreground="#9FB0C9" TextWrapping="Wrap" MaxWidth="330"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Name="WPFRedesignProgress">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Visibility, ElementName=WPFTweaksProgressBar}" Value="Visible">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Grid>
                                <TextBlock Text="{Binding Text, ElementName=WPFTweaksProgressLabel}" FontSize="{DynamicResource RdFontBody}" FontWeight="Bold" Foreground="#EAF0FA" TextTrimming="CharacterEllipsis" Margin="0,0,56,0"/>
                                <TextBlock Text="{Binding Value, ElementName=WPFTweaksProgressValue, StringFormat={}{0:0}%}" FontSize="{DynamicResource RdFontBody}" Foreground="#9FB0C9" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar Margin="0,10,0,0" Height="10" Minimum="0" Maximum="100"
                                         Value="{Binding Value, ElementName=WPFTweaksProgressValue}"
                                         Foreground="{Binding Foreground, ElementName=WPFTweaksProgressValue}"
                                         Style="{StaticResource RdBarStyle}" AutomationProperties.Name="Progress"/>
                            <Button Name="WPFRedesignNewSelection" Height="48" Margin="0,14,0,0" Content="New selection">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource RdSecondaryButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Value, ElementName=WPFTweaksProgressValue}" Value="100">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock Name="WPFRedesignDoneNote" Text="" FontSize="{DynamicResource RdFontSmall}" Foreground="#9FB0C9" TextWrapping="Wrap" Margin="0,8,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Value, ElementName=WPFTweaksProgressValue}" Value="100">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>

    <!-- Window-level progress for the tabs that do not show the right panel -->
    <Border Grid.Row="3" Background="#8C090E1A">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, ElementName=WPFTab2}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    <!-- The programs tab has its own bar in the action dock -->
                    <DataTrigger Binding="{Binding IsSelected, ElementName=WPFTab1}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <ContentControl Slot="Progress"/>
    </Border>

    <!-- New custom kit: modal over the whole window. Filled in by Show-WinUtilRedesignKitDialog. -->
    <Border Name="WPFRedesignKitScrim" Grid.Row="0" Grid.RowSpan="4" Background="#D9060B16" Visibility="Collapsed" Panel.ZIndex="50">
        <Border Width="480" MaxHeight="720" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28,26,28,24" CornerRadius="20" BorderThickness="1" BorderBrush="#2A4A73" Background="#0F1A30">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.6" BlurRadius="40" ShadowDepth="10"/>
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Name="WPFRedesignKdTitle" Text="New custom kit" FontSize="{DynamicResource RdFontHeading}" FontWeight="ExtraBold" Foreground="#EAF0FA" TextWrapping="Wrap"/>
                    <TextBlock Name="WPFRedesignKdIntro" Text="" FontSize="{DynamicResource RdFontBody}" Foreground="#9FB0C9" TextWrapping="Wrap" Margin="0,6,0,0"/>

                    <TextBlock Name="WPFRedesignKdNameLabel" Text="" FontSize="{DynamicResource RdFontSmall}" FontWeight="Bold" Foreground="#9FB0C9" Margin="0,18,0,6"/>
                    <Grid>
                        <TextBox Name="WPFRedesignKdName" Style="{StaticResource RdTextBoxStyle}" MaxLength="60" AutomationProperties.Name="Kit name"/>
                        <TextBlock Name="WPFRedesignKdNameHint" IsHitTestVisible="False" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource RdFontBody}" Foreground="#7F92B3" Text="">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=WPFRedesignKdName}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <TextBlock Name="WPFRedesignKdDescLabel" Text="" FontSize="{DynamicResource RdFontSmall}" FontWeight="Bold" Foreground="#9FB0C9" Margin="0,14,0,6"/>
                    <Grid>
                        <TextBox Name="WPFRedesignKdDesc" Style="{StaticResource RdTextBoxStyle}" MaxLength="140" AutomationProperties.Name="Description"/>
                        <TextBlock Name="WPFRedesignKdDescHint" IsHitTestVisible="False" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource RdFontBody}" Foreground="#7F92B3" Text="">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=WPFRedesignKdDesc}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <TextBlock Name="WPFRedesignKdColorLabel" Text="" FontSize="{DynamicResource RdFontSmall}" FontWeight="Bold" Foreground="#9FB0C9" Margin="0,14,0,2"/>
                    <WrapPanel Name="WPFRedesignKdColors"/>

                    <TextBlock Name="WPFRedesignKdProgramsLabel" Text="" FontSize="{DynamicResource RdFontSmall}" FontWeight="Bold" Foreground="#9FB0C9" Margin="0,10,0,6"/>
                    <ScrollViewer MaxHeight="104" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel Name="WPFRedesignKdPrograms"/>
                    </ScrollViewer>

                    <Border Margin="0,16,0,0" Padding="14,12" CornerRadius="12" Background="#10304A" BorderBrush="#1C4A70" BorderThickness="1">
                        <TextBlock Name="WPFRedesignKdTip" Text="" FontSize="{DynamicResource RdFontSmall}" Foreground="#CFE0F5" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock Name="WPFRedesignKdError" Text="" Visibility="Collapsed" FontSize="{DynamicResource RdFontBody}" FontWeight="SemiBold" Foreground="#FF9C9C" TextWrapping="Wrap" Margin="0,12,0,0"/>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Name="WPFRedesignKdCancel" Grid.Column="0" Height="48" Style="{StaticResource RdSecondaryButtonStyle}" Content="Cancel"/>
                        <Button Name="WPFRedesignKdSave" Grid.Column="2" Height="48" Style="{StaticResource RdPrimaryButtonStyle}" Content="Save kit"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Border>
</Grid>
