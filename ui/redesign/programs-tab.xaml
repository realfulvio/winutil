<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <!-- Kits, chips and the catalog. The cards are added here by Initialize-WinUtilRedesignPrograms. -->
    <ScrollViewer Name="WPFRedesignProgScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="2,2,10,0">
        <!-- The space under the list is the content's own margin: a ScrollViewer's padding would cut the viewport instead -->
        <StackPanel Name="WPFRedesignProgContent" Margin="0,0,0,150">
            <Grid Margin="0,10,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="WPFRedesignKitsLabel" Grid.Column="0" Text="KITS" FontSize="{DynamicResource RdFontSmall}" FontWeight="Bold" Foreground="#9FB0C9" VerticalAlignment="Center"/>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Button Name="WPFRedesignKitImport" Style="{StaticResource RdSecondaryButtonStyle}" Height="44" Padding="16,0" Margin="8,0,0,0" Content="Import kit"/>
                    <Button Name="WPFRedesignKitCreate" Style="{StaticResource RdSecondaryButtonStyle}" Height="44" Padding="16,0" Margin="8,0,0,0" Content="Create kit from selection"/>
                </WrapPanel>
            </Grid>
            <WrapPanel Name="WPFRedesignKitList" Margin="0,0,0,24"/>

            <TextBlock Name="WPFRedesignCatalogLabel" Text="CATALOG" FontSize="{DynamicResource RdFontSmall}" FontWeight="Bold" Foreground="#9FB0C9"/>
            <WrapPanel Name="WPFRedesignProgChips" Margin="0,12,0,4"/>
            <WrapPanel Name="WPFRedesignProgGrid"/>
            <TextBlock Name="WPFRedesignProgNoResults" Text="" Visibility="Collapsed" FontSize="{DynamicResource RdFontMedium}" Foreground="#9FB0C9" TextWrapping="Wrap" Margin="4,16,0,0"/>
        </StackPanel>
    </ScrollViewer>

    <!-- Floating action bar: selection, install, progress -->
    <Border Name="WPFRedesignDock" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="12,0,22,24" MaxWidth="860"
            CornerRadius="20" BorderThickness="1" BorderBrush="#3A5C92" Padding="22,12,12,12">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#EB1B2D4E" Offset="0"/>
                <GradientStop Color="#F0101C36" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.55" BlurRadius="34" ShadowDepth="10"/>
        </Border.Effect>
        <Grid>
            <!-- Idle: what is selected and the actions -->
            <Grid Name="WPFRedesignDockIdle">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Visibility, ElementName=WPFTweaksProgressBar}" Value="Visible">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Name="WPFRedesignDockTitle" Text="" FontSize="{DynamicResource RdFontLead}" FontWeight="Bold" Foreground="#EAF0FA" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Name="WPFRedesignDockSub" Text="" FontSize="{DynamicResource RdFontSmall}" Foreground="#B7C6DE" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="WPFRedesignDockClear" Style="{StaticResource RdSecondaryButtonStyle}" Height="48" Padding="18,0" Content="Clear"/>
                    <Button Name="WPFRedesignDockInstall" Style="{StaticResource RdPrimaryButtonStyle}" Height="48" MinWidth="140" Padding="22,0" Margin="10,0,0,0" Content="Install"/>
                    <Button Name="WPFRedesignDockMore" Style="{StaticResource RdSecondaryButtonStyle}" Height="48" Width="48" Padding="0" Margin="10,0,0,0"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource RdIconM}" Content="&#xE712;" ToolTip="More actions" AutomationProperties.Name="More actions"/>
                    <Popup Name="WPFRedesignDockMenu" PlacementTarget="{Binding ElementName=WPFRedesignDockMore}" Placement="Top" VerticalOffset="-8" HorizontalOffset="-268"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Width="300" Margin="0,0,16,16" Padding="8" CornerRadius="16" BorderThickness="1" BorderBrush="#2A4A73" Background="#0F1A30">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.55" BlurRadius="24" ShadowDepth="6"/>
                            </Border.Effect>
                            <StackPanel>
                                <Button Name="WPFRedesignMenuUninstall" Style="{StaticResource RdGhostButtonStyle}" Content="Uninstall the selection"/>
                                <Button Name="WPFRedesignMenuUpgradeAll" Style="{StaticResource RdGhostButtonStyle}" Content="Upgrade all programs"/>
                                <Button Name="WPFRedesignMenuSelectInstalled" Style="{StaticResource RdGhostButtonStyle}" Content="Select installed programs"/>
                                <Border Height="1" Background="#22304D" Margin="6,6"/>
                                <TextBlock Name="WPFRedesignMenuManagerLabel" Text="Package manager" FontSize="{DynamicResource RdFontSmall}" FontWeight="Bold" Foreground="#9FB0C9" Margin="14,2,0,6"/>
                                <WrapPanel Margin="8,0,0,4">
                                    <ToggleButton Name="WPFRedesignMenuWinget" Style="{StaticResource RdChipStyle}" Margin="0,0,8,4" Content="WinGet"/>
                                    <ToggleButton Name="WPFRedesignMenuChoco" Style="{StaticResource RdChipStyle}" Margin="0,0,8,4" Content="Chocolatey"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>

            <!-- Running or just finished: the job's own progress, mirrored -->
            <Grid Name="WPFRedesignDockRun">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Visibility, ElementName=WPFTweaksProgressBar}" Value="Visible">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Grid>
                        <TextBlock Name="WPFRedesignDockRunTitle" Text="{Binding Text, ElementName=WPFTweaksProgressLabel}" FontSize="{DynamicResource RdFontLead}" FontWeight="Bold" Foreground="#EAF0FA" TextTrimming="CharacterEllipsis" Margin="0,0,56,0"/>
                        <TextBlock Text="{Binding Value, ElementName=WPFTweaksProgressValue, StringFormat={}{0:0}%}" FontSize="{DynamicResource RdFontBody}" Foreground="#B7C6DE" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar Name="WPFRedesignDockBar" Margin="0,10,0,0" Height="8" Minimum="0" Maximum="100"
                                 Value="{Binding Value, ElementName=WPFTweaksProgressValue}"
                                 Foreground="{Binding Foreground, ElementName=WPFTweaksProgressValue}"
                                 Style="{StaticResource RdBarStyle}" AutomationProperties.Name="Progress"/>
                    <TextBlock Name="WPFRedesignDockRunNote" Text="" FontSize="{DynamicResource RdFontSmall}" Foreground="#B7C6DE" TextWrapping="Wrap" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Value, ElementName=WPFTweaksProgressValue}" Value="100">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Button Name="WPFRedesignDockDone" Grid.Column="1" Height="48" MinWidth="120" Padding="22,0" Content="Done" VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource RdSecondaryButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Value, ElementName=WPFTweaksProgressValue}" Value="100">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>
    </Border>

    <!-- Details of one program -->
    <Border Name="WPFRedesignDrawer" Grid.Column="1" Width="372" Margin="14,0,0,16" CornerRadius="20" BorderBrush="#1E2A44" BorderThickness="1" ClipToBounds="True" Visibility="Collapsed">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#EB121C33" Offset="0"/>
                <GradientStop Color="#EB0C1324" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,18,24,8">
                <StackPanel>
                    <Grid>
                        <Border Name="WPFRedesignDrawerTile" Width="72" Height="72" CornerRadius="20" HorizontalAlignment="Left" Background="#16223C">
                            <Grid>
                                <Viewbox Name="WPFRedesignDrawerGlyphBox" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Name="WPFRedesignDrawerGlyph" Fill="White" Stretch="Uniform" Width="24" Height="24"/>
                                </Viewbox>
                                <TextBlock Name="WPFRedesignDrawerFont" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="34" Foreground="White" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Name="WPFRedesignDrawerImage" Margin="10" Visibility="Collapsed" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>
                        <Button Name="WPFRedesignDrawerClose" Style="{StaticResource RdCaptionButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Content="&#xE711;" ToolTip="Close" AutomationProperties.Name="Close"/>
                    </Grid>
                    <TextBlock Name="WPFRedesignDrawerName" Text="" FontSize="{DynamicResource RdFontHeading}" FontWeight="ExtraBold" Foreground="#EAF0FA" TextWrapping="Wrap" Margin="0,16,0,0"/>
                    <Border Name="WPFRedesignDrawerState" Style="{StaticResource RdTagBorderStyle}" HorizontalAlignment="Left" Margin="0,10,0,0" Background="#16223C" BorderBrush="#22304D">
                        <TextBlock Name="WPFRedesignDrawerStateText" Text="" FontSize="{DynamicResource RdFontSmall}" FontWeight="SemiBold" Foreground="#CFE0F5" Background="Transparent"/>
                    </Border>
                    <TextBlock Name="WPFRedesignDrawerDesc" Text="" FontSize="{DynamicResource RdFontMedium}" Foreground="#B7C6DE" TextWrapping="Wrap" Margin="0,14,0,16"/>

                    <Border BorderBrush="#1E2A44" BorderThickness="0,1,0,0" Padding="0,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Name="WPFRedesignDrawerCategoryLabel" Text="Category" FontSize="{DynamicResource RdFontBody}" Foreground="#9FB0C9"/>
                            <TextBlock Name="WPFRedesignDrawerCategory" Grid.Column="1" Text="" FontSize="{DynamicResource RdFontBody}" Foreground="#EAF0FA" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                    <Border BorderBrush="#1E2A44" BorderThickness="0,1,0,0" Padding="0,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Name="WPFRedesignDrawerSourceLabel" Text="Source" FontSize="{DynamicResource RdFontBody}" Foreground="#9FB0C9"/>
                            <TextBlock Name="WPFRedesignDrawerSource" Grid.Column="1" Text="" FontSize="{DynamicResource RdFontBody}" Foreground="#EAF0FA" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                    <Border Name="WPFRedesignDrawerLicenseRow" BorderBrush="#1E2A44" BorderThickness="0,1,0,0" Padding="0,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Name="WPFRedesignDrawerLicenseLabel" Text="License" FontSize="{DynamicResource RdFontBody}" Foreground="#9FB0C9"/>
                            <TextBlock Name="WPFRedesignDrawerLicense" Grid.Column="1" Text="" FontSize="{DynamicResource RdFontBody}" Foreground="#EAF0FA" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                    <Border Name="WPFRedesignDrawerWebsiteRow" BorderBrush="#1E2A44" BorderThickness="0,1,0,0" Padding="0,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Name="WPFRedesignDrawerWebsiteLabel" Text="Website" FontSize="{DynamicResource RdFontBody}" Foreground="#9FB0C9" VerticalAlignment="Center"/>
                            <Button Name="WPFRedesignDrawerWebsite" Grid.Column="1" Style="{StaticResource RdGhostButtonStyle}" Padding="0" MinHeight="44" HorizontalAlignment="Left">
                                <TextBlock Name="WPFRedesignDrawerWebsiteText" Text="" FontSize="{DynamicResource RdFontBody}" Foreground="#7FD3FF" TextDecorations="Underline" TextTrimming="CharacterEllipsis" MaxWidth="220" Background="Transparent"/>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" Padding="24,16,24,20" BorderBrush="#1E2A44" BorderThickness="0,1,0,0" Background="#8C090E1A">
                <Button Name="WPFRedesignDrawerAction" Height="52" Style="{StaticResource RdPrimaryButtonStyle}" Content="Add to selection"/>
            </Border>
        </Grid>
    </Border>
</Grid>
