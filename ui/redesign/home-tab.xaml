<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="2,8,10,24">
        <UniformGrid Name="WPFRedesignHomeGrid" Columns="2">
            <Button Name="WPFRedesignHomeCard1" Style="{StaticResource RdHomeCardStyle}" Margin="0,0,16,16" AutomationProperties.Name="Install programs">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Width="48" Height="48" CornerRadius="15" HorizontalAlignment="Left">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1D6FE0" Offset="0"/><GradientStop Color="#0C3A8A" Offset="1"/></LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="1" FontSize="{DynamicResource RdFontLarge}" FontWeight="ExtraBold" Foreground="White" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="0,16,0,0">
                        <TextBlock Name="WPFRedesignHomeTitle1" Text="" FontSize="{DynamicResource RdFontHeading}" FontWeight="ExtraBold" Foreground="#EAF0FA" Background="Transparent" TextWrapping="Wrap"/>
                        <TextBlock Name="WPFRedesignHomeDesc1" Text="" FontSize="{DynamicResource RdFontMedium}" Foreground="#9FB0C9" Background="Transparent" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Name="WPFRedesignHomeOpen1" Text="Open" FontSize="{DynamicResource RdFontBody}" FontWeight="Bold" Foreground="#7FD3FF" Background="Transparent" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource RdIconS}" Foreground="#7FD3FF" Background="Transparent" Margin="8,2,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Button>
            <Button Name="WPFRedesignHomeCard2" Style="{StaticResource RdHomeCardStyle}" Margin="0,0,0,16" AutomationProperties.Name="Optimize Windows">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Width="48" Height="48" CornerRadius="15" HorizontalAlignment="Left">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#7A4BE0" Offset="0"/><GradientStop Color="#3A1F8F" Offset="1"/></LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="2" FontSize="{DynamicResource RdFontLarge}" FontWeight="ExtraBold" Foreground="White" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="0,16,0,0">
                        <TextBlock Name="WPFRedesignHomeTitle2" Text="" FontSize="{DynamicResource RdFontHeading}" FontWeight="ExtraBold" Foreground="#EAF0FA" Background="Transparent" TextWrapping="Wrap"/>
                        <TextBlock Name="WPFRedesignHomeDesc2" Text="" FontSize="{DynamicResource RdFontMedium}" Foreground="#9FB0C9" Background="Transparent" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Name="WPFRedesignHomeOpen2" Text="Open" FontSize="{DynamicResource RdFontBody}" FontWeight="Bold" Foreground="#7FD3FF" Background="Transparent" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource RdIconS}" Foreground="#7FD3FF" Background="Transparent" Margin="8,2,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Button>
            <Button Name="WPFRedesignHomeCard3" Style="{StaticResource RdHomeCardStyle}" Margin="0,0,16,0" AutomationProperties.Name="Keep everything up to date">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Width="48" Height="48" CornerRadius="15" HorizontalAlignment="Left">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0C7A58" Offset="0"/><GradientStop Color="#08493A" Offset="1"/></LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="3" FontSize="{DynamicResource RdFontLarge}" FontWeight="ExtraBold" Foreground="White" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="0,16,0,0">
                        <TextBlock Name="WPFRedesignHomeTitle3" Text="" FontSize="{DynamicResource RdFontHeading}" FontWeight="ExtraBold" Foreground="#EAF0FA" Background="Transparent" TextWrapping="Wrap"/>
                        <TextBlock Name="WPFRedesignHomeDesc3" Text="" FontSize="{DynamicResource RdFontMedium}" Foreground="#9FB0C9" Background="Transparent" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Name="WPFRedesignHomeOpen3" Text="Open" FontSize="{DynamicResource RdFontBody}" FontWeight="Bold" Foreground="#7FD3FF" Background="Transparent" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource RdIconS}" Foreground="#7FD3FF" Background="Transparent" Margin="8,2,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Button>
            <Button Name="WPFRedesignHomeCard4" Style="{StaticResource RdHomeCardStyle}" Margin="0" AutomationProperties.Name="Fix a problem">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Width="48" Height="48" CornerRadius="15" HorizontalAlignment="Left">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#B35C0B" Offset="0"/><GradientStop Color="#6B3205" Offset="1"/></LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="4" FontSize="{DynamicResource RdFontLarge}" FontWeight="ExtraBold" Foreground="White" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="0,16,0,0">
                        <TextBlock Name="WPFRedesignHomeTitle4" Text="" FontSize="{DynamicResource RdFontHeading}" FontWeight="ExtraBold" Foreground="#EAF0FA" Background="Transparent" TextWrapping="Wrap"/>
                        <TextBlock Name="WPFRedesignHomeDesc4" Text="" FontSize="{DynamicResource RdFontMedium}" Foreground="#9FB0C9" Background="Transparent" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Name="WPFRedesignHomeOpen4" Text="Open" FontSize="{DynamicResource RdFontBody}" FontWeight="Bold" Foreground="#7FD3FF" Background="Transparent" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource RdIconS}" Foreground="#7FD3FF" Background="Transparent" Margin="8,2,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Button>
        </UniformGrid>
    </ScrollViewer>
</Grid>
